# Copy this file to .env and change what you need. All values are optional.
MONGO_URI=mongodb://127.0.0.1:27017
DB_NAME=library_management
PORT=3000

# Library rules
LOAN_DAYS=14
MAX_ACTIVE_LOANS=3
FINE_PER_DAY=10
# Days a returned copy is held for the next reservation
HOLD_DAYS=3
# Borrowers who owe more than this in unpaid fines can't borrow
MAX_UNPAID_FINE=100

# Reminders: sent this many days before the due date, checked every N minutes
REMINDER_DAYS_BEFORE=2
REMINDER_CHECK_MINUTES=60

# Email reminders (any SMTP server, e.g. Gmail with an app password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=Library <you@gmail.com>

# SMS reminders (Twilio)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+15550000000

# Automatic backups
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=7
# BACKUP_DIR=./backups

# Set to off to disable reminders, hold expiry and automatic backups
# SCHEDULER=off
